+
+static inline uchar
+read_wd33c93(const wd33c93_regs regs, uchar reg_num)
+{
+	outb(reg_num, wd33c93_ioport(regs.SASR));
+	return inb(wd33c93_ioport(regs.SCMD));
+}
+
+static unsigned long
+read_wd33c93_count(const wd33c93_regs regs)
+{
