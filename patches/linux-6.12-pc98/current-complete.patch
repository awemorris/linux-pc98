 		x86_platform.set_legacy_features();
 }
diff --git a/arch/x86/kernel/setup.c b/arch/x86/kernel/setup.c
index f1fea506e20f417bdb6d27c98f7f9919c87533b2..b631985fdeca224380f7fd90d4d0af2f9fda5c13 100644
--- a/arch/x86/kernel/setup.c
+++ b/arch/x86/kernel/setup.c
@@ -518,6 +518,16 @@ void __init reserve_standard_io_resources(void)
 {
 	int i;
 
+	/*
+	 * This table describes the PC/AT I/O map.  Several ranges are active
+	 * PC-9800 devices instead: 0x41/0x43 is the keyboard and 0xf0 is the
+	 * reset port, for example.  Reserving the AT ranges prevents the native
+	 * PC-9800 drivers from claiming their hardware.  Leave ownership to the
+	 * native drivers rather than installing knowingly false reservations.
+	 */
+	if (IS_ENABLED(CONFIG_X86_PC9800))
+		return;
+
 	/* request I/O space for devices used on all i[345]86 PCs */
 	for (i = 0; i < ARRAY_SIZE(standard_io_resources); i++)
 		request_resource(&ioport_resource, &standard_io_resources[i]);
diff --git a/arch/x86/mm/init.c b/arch/x86/mm/init.c
index eb503f53c3195ca4f299593c0112dab0fb09e7dd..1c6626666a5d095e31c4251a6a599db4571df267 100644
--- a/arch/x86/mm/init.c
+++ b/arch/x86/mm/init.c
@@ -640,8 +640,20 @@ static void __init memory_map_top_down(unsigned long map_start,
 	 */
 	addr = memblock_phys_alloc_range(PMD_SIZE, PMD_SIZE, map_start,
 					 map_end);
-	memblock_phys_free(addr, PMD_SIZE);
-	real_end = addr + PMD_SIZE;
+	if (addr) {
+		memblock_phys_free(addr, PMD_SIZE);
+		real_end = addr + PMD_SIZE;
+	} else {
+		/*
+		 * No PMD_SIZE-aligned free block fits in [map_start, map_end)
+		 * (seen on tiny/fragmented low memory, e.g. an 8 MiB PC-9800).
+		 * Do NOT free the bogus addr 0 range: that would drop the
+		 * reserved low 1 MiB (incl. the read-only realmode trampoline),
+		 * which then gets handed to the allocator and faults on write.
+		 * Fall back to mapping the whole range with BRK page tables.
+		 */
+		real_end = map_start;
+	}
 
 	/* step_size need to be small so pgt_buf from BRK could cover it */
 	step_size = PMD_SIZE;
