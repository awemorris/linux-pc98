[submodule "external/musl"]
	path = external/musl
	url = https://github.com/awemorris/musl-i386.git
	branch = main
[submodule "external/gcc"]
	path = external/gcc
	url = https://github.com/awemorris/gcc-i386.git
	branch = main
[submodule "external/glibc"]
	path = external/glibc
	url = https://github.com/awemorris/glibc-i386.git
	branch = port/glibc-2.41-i386
[submodule "external/qemu-pc98"]
	path = external/qemu-pc98
	url = https://github.com/awemorris/qemu-pc98.git
	branch = master
[submodule "external/debian-i486"]
	path = external/debian-i486
	url = https://github.com/awemorris/debian-i486.git
	branch = main
[submodule "external/zedBSD"]
	path = external/zedBSD
	url = https://github.com/awemorris/zedBSD.git
	branch = main
[submodule "external/noct"]
	path = external/noct
	url = https://github.com/awemorris/NoctLang.git
