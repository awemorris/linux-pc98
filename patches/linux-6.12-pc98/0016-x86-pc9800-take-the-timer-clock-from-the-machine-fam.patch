From 36d25fb171df1443a37304c8565c14b1934554c5 Mon Sep 17 00:00:00 2001
From: hayao <shun819.mail@gmail.com>
Date: Tue, 28 Jul 2026 22:26:48 +0900
Subject: [PATCH 16/16] x86/pc9800: take the timer clock from the machine
 family

---
 arch/x86/kernel/pc9800.c       | 20 ++++++++++++++++++++
 drivers/tty/serial/pc98_8251.c |  5 ++++-
 include/linux/timex.h          | 10 +++++++---
 3 files changed, 31 insertions(+), 4 deletions(-)

diff --git a/arch/x86/kernel/pc9800.c b/arch/x86/kernel/pc9800.c
index 2b39db6b71b3..ca84d6884ca7 100644
--- a/arch/x86/kernel/pc9800.c
+++ b/arch/x86/kernel/pc9800.c
@@ -13,9 +13,11 @@
  * touching 0x70/0x71, which on this machine are the PIT's ports.
  */
 #include <linux/bcd.h>
+#include <linux/export.h>
 #include <linux/init.h>
 #include <linux/io.h>
 #include <linux/time.h>
+#include <linux/timex.h>
 
 #include <asm/pc9800.h>
 #include <asm/reboot.h>
@@ -23,6 +25,17 @@
 
 #define PC98_RESET_PORT	0xf0
 
+/* BIOS work area. Bit 7 of the flag byte marks an 8MHz-family machine. */
+#define PC98_BIOS_FLAG	0x501
+#define BIOS_FLAG_8MHZ	0x80
+
+#define PC98_CLOCK_5MHZ	2457600ul
+#define PC98_CLOCK_8MHZ	1996800ul
+
+/* Both the PIT and the 8251's baud generator run off this. */
+unsigned long pc9800_pit_tick_rate = PC98_CLOCK_5MHZ;
+EXPORT_SYMBOL_GPL(pc9800_pit_tick_rate);
+
 #define PC98_RTC_CTRL	0x20		/* W: command bits, CLK, STB, data */
 #define PC98_RTC_DATA	0x33		/* R: bit 0 is the serial output */
 #define PC98_IO_WAIT	0x5f		/* the machine's own I/O delay port */
@@ -121,6 +134,13 @@ static int pc9800_set_wallclock(const struct timespec64 *now)
 
 void __init pc9800_init_platform(void)
 {
+	u8 flag = readb((void __iomem *)(__ISA_IO_base + PC98_BIOS_FLAG));
+
+	/* Runs from setup_arch(), so this lands before the PIT is programmed
+	 * and before the TSC is calibrated against it. */
+	if (flag & BIOS_FLAG_8MHZ)
+		pc9800_pit_tick_rate = PC98_CLOCK_8MHZ;
+
 	/* No CMOS RTC and no 8042 on this machine. Letting the generic code
 	 * poke at them would be actively harmful: 0x71 is a PIT counter and
 	 * 0x60 is the text GDC. */
diff --git a/drivers/tty/serial/pc98_8251.c b/drivers/tty/serial/pc98_8251.c
index dd99ecb6ef5f..6f0f383c7d42 100644
--- a/drivers/tty/serial/pc98_8251.c
+++ b/drivers/tty/serial/pc98_8251.c
@@ -23,6 +23,7 @@
 #include <linux/platform_device.h>
 #include <linux/serial_core.h>
 #include <linux/timer.h>
+#include <linux/timex.h>
 #include <linux/tty.h>
 #include <linux/tty_flip.h>
 
@@ -45,7 +46,9 @@
 #define CMD_ERRRST		0x10
 #define CMD_RTS			0x20
 
-#define PC98_UARTCLK		2457600	/* 8253 input on a 5MHz-family PC-98 */
+/* The baud generator is 8253 counter 2, so it runs off the PIT's input clock —
+ * which is 2.4576 MHz or 1.9968 MHz depending on the machine family. */
+#define PC98_UARTCLK		PIT_TICK_RATE
 #define POLL_INTERVAL_MS	5
 
 static struct uart_port pc98_port;
diff --git a/include/linux/timex.h b/include/linux/timex.h
index ea841bd798d8..ca767acd2298 100644
--- a/include/linux/timex.h
+++ b/include/linux/timex.h
@@ -168,9 +168,13 @@ int read_current_timer(unsigned long *timer_val);
 
 /* The clock frequency of the i8253/i8254 PIT */
 #ifdef CONFIG_X86_PC9800
-/* PC-9800's 8253 is clocked at 2.4576 MHz on 5MHz-family machines (NP2kai's
- * default); 8MHz-family machines use 1.9968 MHz. */
-#define PIT_TICK_RATE 2457600ul
+/*
+ * PC-9800 clocks its 8253 at 2.4576 MHz on 5MHz-family machines and 1.9968 MHz
+ * on 8MHz-family ones, so which it is can only be known at run time. The value
+ * is settled in pc9800_init_platform(), long before any timer is programmed.
+ */
+extern unsigned long pc9800_pit_tick_rate;
+#define PIT_TICK_RATE pc9800_pit_tick_rate
 #else
 #define PIT_TICK_RATE 1193182ul
 #endif
-- 
2.54.0

