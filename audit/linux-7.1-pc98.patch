+{
+	outb(WD_TRANSFER_COUNT_MSB, wd33c93_ioport(regs.SASR));
+	outb(value >> 16, wd33c93_ioport(regs.SCMD));
+	outb(value >> 8, wd33c93_ioport(regs.SCMD));
+	outb(value, wd33c93_ioport(regs.SCMD));
+}
+
+static inline void
