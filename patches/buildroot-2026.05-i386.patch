diff --git a/package/musl/musl.mk b/package/musl/musl.mk
index af9e7e7a..e1cf4025 100644
--- a/package/musl/musl.mk
+++ b/package/musl/musl.mk
@@ -39,6 +39,15 @@ ifeq ($(BR2_ARM_INSTRUCTIONS_THUMB),y)
 MUSL_EXTRA_CFLAGS += -marm
 endif
 
+# mallocng uses compare-and-exchange directly.  The older allocator uses
+# musl's internal lock abstraction, which has an i386 TAS implementation.
+ifeq ($(BR2_x86_i386),y)
+MUSL_CONF_OPTS += --with-malloc=oldmalloc
+MUSL_EXTRA_CFLAGS += -march=i386 -mtune=i386
+MUSL_EXTRA_CFLAGS += -fno-isolate-erroneous-paths-dereference
+MUSL_EXTRA_CFLAGS += -DMUSL_I386_SINGLE_THREAD -DMUSL_NO_FLOAT
+endif
+
 define MUSL_CONFIGURE_CMDS
 	(cd $(@D); \
 		$(TARGET_CONFIGURE_OPTS) \
@@ -57,6 +64,7 @@ define MUSL_CONFIGURE_CMDS
 			--libdir=/lib \
 			--disable-gcc-wrapper \
 			--enable-static \
+			$(MUSL_CONF_OPTS) \
 			$(if $(BR2_STATIC_LIBS),--disable-shared,--enable-shared))
 endef
 
