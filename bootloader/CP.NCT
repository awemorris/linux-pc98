func foldAscii(character) {
    var lower = "abcdefghijklmnopqrstuvwxyz";
    var upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    var index = String.indexOf(lower, character);
    if (index >= 0)
        return String.substring(upper, index, 1);
    return character;
}

func pathsEqual(left, right) {
    var left_start = 0;
    var right_start = 0;
    var left_length = String.charCount(left);
    var right_length = String.charCount(right);

    if (left_length > 0 && String.charAt(left, 0) == "/")
        left_start = 1;
    if (right_length > 0 && String.charAt(right, 0) == "/")
        right_start = 1;
    left_length -= left_start;
    right_length -= right_start;
    if (left_length != right_length)
        return 0;
    for (index in 0..left_length) {
        if (foldAscii(String.charAt(left, left_start + index)) !=
            foldAscii(String.charAt(right, right_start + index)))
            return 0;
    }
    return 1;
}

func main(args) {
    if (Array.size(args) != 2) {
        Console.print("usage: cp SOURCE DESTINATION");
        return 2;
    }

    var source_path = args[0];
    var destination_path = args[1];
    if (pathsEqual(source_path, destination_path)) {
        Console.print("cp: source and destination are the same file");
        return 2;
    }
    if (FileUtil.checkFileExists(source_path)) {
        var total = FileUtil.getFileSize(source_path);
        var source = File.open(source_path, "rb");
        var destination = File.open(destination_path, "wb");
        var copied = 0;

        while (copied < total) {
            var length = 8192;
            if (total - copied < length)
                length = total - copied;
            var data = File.read(source, length);
            var actual = Packed.size(data);
            if (actual != length) {
                File.close(destination);
                File.close(source);
                Console.print("cp: short read");
                return 1;
            }
            if (File.write(destination, data, 0, actual)) {
                copied += actual;
            } else {
                File.close(destination);
                File.close(source);
                Console.print("cp: short write");
                return 1;
            }
        }

        File.close(destination);
        File.close(source);
        Console.print("Copied " + copied + " bytes.");
        return 0;
    }

    Console.print("cp: source file not found: " + source_path);
    return 1;
}
