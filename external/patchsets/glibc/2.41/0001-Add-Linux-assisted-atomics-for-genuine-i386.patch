index cdbd5553..dbc68c17 100644
--- a/config.h.in
+++ b/config.h.in
@@ -178,6 +178,9 @@
 /* Mach/i386 specific: define if the `i386_set_gdt' RPC is available.  */
 #undef	HAVE_I386_SET_GDT
 
+/* Define if exact-i386 atomics are provided by the PC-98 Linux kernel.  */
+#undef	HAVE_I386_KERNEL_ATOMICS
+
 /* Hurd specific; define if the `proc_getchildren_rusage' RPC is available.  */
 #undef HAVE_HURD_PROC_GETCHILDREN_RUSAGE
 
diff --git a/configure b/configure
index eb8abd00..38eeb700 100755
--- a/configure
+++ b/configure
@@ -808,6 +808,7 @@ enable_static_nss
 enable_force_install
 enable_maintainer_mode
 enable_kernel
+enable_i386_kernel_atomics
 enable_werror
 enable_multi_arch
 enable_memory_tagging
@@ -1485,6 +1486,8 @@ Optional Features:
                           sometimes confusing) to the casual installer
   --enable-kernel=VERSION compile for compatibility with kernel not older than
                           VERSION
+  --enable-i386-kernel-atomics
+                          use the PC-98 Linux i386 atomic syscall [default=no]
   --disable-werror        do not build with -Werror
   --enable-multi-arch     enable single DSO with optimizations for multiple
                           architectures
@@ -4657,6 +4660,19 @@ then :
   enableval=$enable_kernel; minimum_kernel=$enableval
 fi
 
+# Check whether --enable-i386-kernel-atomics was given.
+if test ${enable_i386_kernel_atomics+y}
+then :
+  enableval=$enable_i386_kernel_atomics; enable_i386_kernel_atomics=$enableval
+else case e in #(
+  e) enable_i386_kernel_atomics=no ;;
+esac
+fi
+
+case "$enable_i386_kernel_atomics" in
+yes|no) ;;
+*) as_fn_error $? "Not a valid argument for --enable-i386-kernel-atomics: \"$enable_i386_kernel_atomics\"" "$LINENO" 5;;
+esac
 if test "$minimum_kernel" = yes || test "$minimum_kernel" = no; then
   # Better nothing than this.
   minimum_kernel=""
diff --git a/configure.ac b/configure.ac
index 050bfa65..191f2225 100644
--- a/configure.ac
+++ b/configure.ac
@@ -305,6 +305,19 @@ AC_ARG_ENABLE([kernel],
 			     [compile for compatibility with kernel not older than VERSION]),
 	      [minimum_kernel=$enableval],
 	      [])
+dnl An exact i386 build has no CMPXCHG or XADD instructions.  The PC-98
+dnl Linux port provides a versioned syscall for these operations; require an
+dnl explicit opt-in so a resulting libc is never mistaken for one which runs
+dnl on an unmodified upstream kernel.
+AC_ARG_ENABLE([i386-kernel-atomics],
+	      AS_HELP_STRING([--enable-i386-kernel-atomics],
+			     [use the PC-98 Linux i386 atomic syscall @<:@default=no@:>@]),
+	      [enable_i386_kernel_atomics=$enableval],
+	      [enable_i386_kernel_atomics=no])
+case "$enable_i386_kernel_atomics" in
+yes|no) ;;
+*) AC_MSG_ERROR([Not a valid argument for --enable-i386-kernel-atomics: "$enable_i386_kernel_atomics"]);;
+esac
 dnl Prevent unreasonable values.
 if test "$minimum_kernel" = yes || test "$minimum_kernel" = no; then
   # Better nothing than this.
diff --git a/malloc/memusage.c b/malloc/memusage.c
index 347abba2..1a4ba53a 100644
--- a/malloc/memusage.c
+++ b/malloc/memusage.c
@@ -36,6 +36,22 @@
 #include <machine-sp.h>
 #include <stackinfo.h>  /* For _STACK_GROWS_UP  */
 
+#ifdef HAVE_I386_KERNEL_ATOMICS
+/* C11 atomic read-modify-write builtins become unresolved libatomic calls
+   with -march=i386.  Route the operations used by this optional profiling
+   DSO through libc's exact-i386 atomic implementation instead.  */
+# include <atomic.h>
+# undef atomic_load_explicit
+# undef atomic_fetch_add_explicit
+# undef atomic_compare_exchange_weak
+# define atomic_load_explicit(mem, order) \
+  atomic_load_relaxed (mem)
+# define atomic_fetch_add_explicit(mem, value, order) \
+  atomic_fetch_add_relaxed (mem, value)
+# define atomic_compare_exchange_weak(mem, expected, desired) \
+  atomic_compare_exchange_weak_relaxed (mem, expected, desired)
+#endif
+
 /* Pointer to the real functions.  These are determined used `dlsym'
    when really needed.  */
 static void *(*mallocp)(size_t);
