func main(args) {
    var path = "/";

    if (Array.size(args) > 1) {
        Console.print("usage: ls [PATH]");
        return 2;
    }
    if (Array.size(args) == 1)
        path = args[0];

    var entries = Directory.list(path);
    for (entry in entries) {
        if (entry.directory)
            Console.print(entry.name + "/ " + entry.size);
        else
            Console.print(entry.name + " " + entry.size);
    }
    return 0;
}
