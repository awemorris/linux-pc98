+++ b/sysdeps/i386/nptl/pthread_spin_lock.S
@@ -27,8 +27,14 @@ ENTRY (__pthread_spin_lock)
 	ret
 
 	.align	16
-2:	rep
+2:
+#ifdef HAVE_I386_KERNEL_ATOMICS
+	/* PAUSE (REP NOP) is not implemented by the 80386.  */
 	nop
+#else
+	rep
+	nop
+#endif
 	cmpl	$0, 0(%eax)
 	jg	1b
 	jmp	2b
