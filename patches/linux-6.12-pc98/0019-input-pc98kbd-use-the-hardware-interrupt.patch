From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Awe Morris <awe@noctvm.io>
Date: Thu, 30 Jul 2026 09:15:00 +0900
Subject: [PATCH 19/19] input: pc98kbd: use the hardware interrupt

The PC-9800 keyboard USART has a dedicated IRQ1 but the initial driver polls
its status every 10 ms and inherits the USART configuration from firmware.
That adds input latency and periodic overhead, and fails when firmware leaves
the device in a different state.

Reserve the two I/O ports, initialize the uPD8251 from a known state, and
receive scancodes on IRQ1.  QEMU's level interrupt is cleared by draining the
receive register, matching the hardware protocol.

Signed-off-by: Awe Morris <awe@noctvm.io>
---
 drivers/input/keyboard/pc98kbd.c | 73 +++++++++++++++++++++++---------
 1 file changed, 54 insertions(+), 19 deletions(-)

diff --git a/drivers/input/keyboard/pc98kbd.c b/drivers/input/keyboard/pc98kbd.c
index 897f62a19..07af4f577 100644
--- a/drivers/input/keyboard/pc98kbd.c
+++ b/drivers/input/keyboard/pc98kbd.c
@@ -6,25 +6,38 @@
  * and it raises IRQ1 (master PIC IR1) when a scancode arrives. Each byte is a
  * PC-98 scancode; bit7 set means key release (break), clear means press (make).
  *
- * To keep bring-up simple and robust (and to match the serial driver's
- * approach on this target) RX is polled on a timer instead of taking IRQ1.
- * Scancodes are mapped to Linux keycodes; the VT keyboard layer then applies
- * the loaded keymap, so a US keymap gives the expected ASCII for the letter,
- * digit, space, enter and backspace keys. Some JIS-only symbol keys are mapped
- * approximately.
+ * Scancodes are received on IRQ1 and mapped to Linux keycodes; the VT keyboard
+ * layer then applies the loaded keymap, so a US keymap gives the expected
+ * ASCII for the letter, digit, space, enter and backspace keys. Some JIS-only
+ * symbol keys are mapped approximately.
  */
 #include <linux/input.h>
 #include <linux/init.h>
+#include <linux/interrupt.h>
 #include <linux/io.h>
+#include <linux/ioport.h>
 #include <linux/module.h>
-#include <linux/platform_device.h>
-#include <linux/timer.h>
 
 #define PC98KBD_DATA	0x41	/* R: scancode  W: mode / ctrl-send */
 #define PC98KBD_CMD	0x43	/* R: status    W: command */
 #define PC98KBD_ST_RXRDY 0x02	/* status bit: a scancode is ready */
+#define PC98KBD_IRQ	1
 
-#define POLL_INTERVAL_MS 10
+static void pc98kbd_hw_init(void)
+{
+	/*
+	 * Reset the uPD8251 from an unknown firmware state, select the PC-98
+	 * keyboard's asynchronous mode, then release RTS and enable reception.
+	 * The intermediate command matches NEC firmware initialization.
+	 */
+	outb(0x00, PC98KBD_CMD);
+	outb(0x00, PC98KBD_CMD);
+	outb(0x00, PC98KBD_CMD);
+	outb(0x40, PC98KBD_CMD);
+	outb(0x3a, PC98KBD_CMD);
+	outb(0x32, PC98KBD_CMD);
+	outb(0x16, PC98KBD_CMD);
+}
 
 static const unsigned short pc98kbd_keycode[128] = {
 	[0x00] = KEY_ESC,
@@ -65,10 +78,9 @@ static const unsigned short pc98kbd_keycode[128] = {
 };
 
 static struct input_dev *pc98kbd_dev;
-static struct timer_list pc98kbd_timer;
 static unsigned short pc98kbd_keymap[128];
 
-static void pc98kbd_poll(struct timer_list *t)
+static irqreturn_t pc98kbd_interrupt(int irq, void *dev_id)
 {
 	int reported = 0;
 
@@ -84,16 +96,28 @@ static void pc98kbd_poll(struct timer_list *t)
 	if (reported)
 		input_sync(pc98kbd_dev);
 
-	mod_timer(&pc98kbd_timer, jiffies + msecs_to_jiffies(POLL_INTERVAL_MS));
+	return reported ? IRQ_HANDLED : IRQ_NONE;
 }
 
 static int __init pc98kbd_init(void)
 {
 	int i, err;
 
+	if (!request_region(PC98KBD_DATA, 1, "pc98kbd-data")) {
+		pr_err("pc98kbd: data port 0x%x is busy\n", PC98KBD_DATA);
+		return -EBUSY;
+	}
+	if (!request_region(PC98KBD_CMD, 1, "pc98kbd-command")) {
+		pr_err("pc98kbd: command port 0x%x is busy\n", PC98KBD_CMD);
+		err = -EBUSY;
+		goto err_release_data;
+	}
+
 	pc98kbd_dev = input_allocate_device();
-	if (!pc98kbd_dev)
-		return -ENOMEM;
+	if (!pc98kbd_dev) {
+		err = -ENOMEM;
+		goto err_release_command;
+	}
 
 	pc98kbd_dev->name = "PC-9800 keyboard";
 	pc98kbd_dev->phys = "pc98kbd/input0";
@@ -115,18 +139,35 @@ static int __init pc98kbd_init(void)
 	err = input_register_device(pc98kbd_dev);
 	if (err) {
 		input_free_device(pc98kbd_dev);
-		return err;
+		goto err_release_command;
 	}
 
-	timer_setup(&pc98kbd_timer, pc98kbd_poll, 0);
-	mod_timer(&pc98kbd_timer, jiffies + msecs_to_jiffies(POLL_INTERVAL_MS));
+	err = request_irq(PC98KBD_IRQ, pc98kbd_interrupt, 0,
+			  "pc98kbd", pc98kbd_dev);
+	if (err) {
+		pr_err("pc98kbd: cannot request IRQ %u: %d\n",
+		       PC98KBD_IRQ, err);
+		goto err_unregister_input;
+	}
+
+	pc98kbd_hw_init();
 	return 0;
+
+err_unregister_input:
+	input_unregister_device(pc98kbd_dev);
+err_release_command:
+	release_region(PC98KBD_CMD, 1);
+err_release_data:
+	release_region(PC98KBD_DATA, 1);
+	return err;
 }
 
 static void __exit pc98kbd_exit(void)
 {
-	del_timer_sync(&pc98kbd_timer);
+	free_irq(PC98KBD_IRQ, pc98kbd_dev);
 	input_unregister_device(pc98kbd_dev);
+	release_region(PC98KBD_CMD, 1);
+	release_region(PC98KBD_DATA, 1);
 }
 
 module_init(pc98kbd_init);
-- 
2.47.2
