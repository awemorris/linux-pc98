From e8114ba3f1ab3886e2fcfd3704ca94a7f66caf88 Mon Sep 17 00:00:00 2001
From: hayao <shun819.mail@gmail.com>
Date: Tue, 28 Jul 2026 00:31:45 +0900
Subject: [PATCH 11/16] x86/irq: unmask the cascade line the platform actually
 uses

---
 arch/x86/kernel/irqinit.c | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/arch/x86/kernel/irqinit.c b/arch/x86/kernel/irqinit.c
index f79c5edc0b89..6fa6b0b5d920 100644
--- a/arch/x86/kernel/irqinit.c
+++ b/arch/x86/kernel/irqinit.c
@@ -105,8 +105,14 @@ void __init native_init_IRQ(void)
 	lapic_assign_system_vectors();
 
 	if (!acpi_ioapic && !of_ioapic && nr_legacy_irqs()) {
-		/* IRQ2 is cascade interrupt to second interrupt controller */
-		if (request_irq(2, no_action, IRQF_NO_THREAD, "cascade", NULL))
+		/*
+		 * Unmask the line the second PIC is cascaded into, otherwise
+		 * none of its interrupts reach the CPU. That is IRQ2 on a
+		 * PC/AT but IRQ7 on a PC-9800, so ask the header rather than
+		 * hardcoding a 2.
+		 */
+		if (request_irq(PIC_CASCADE_IR, no_action, IRQF_NO_THREAD,
+				"cascade", NULL))
 			pr_err("%s: request_irq() failed\n", "cascade");
 	}
 }
