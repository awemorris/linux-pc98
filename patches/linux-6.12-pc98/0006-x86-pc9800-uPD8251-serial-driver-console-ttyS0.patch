From adfd560416650dfbc070471c2d0d1152573692e5 Mon Sep 17 00:00:00 2001
From: hayao <shun819.mail@gmail.com>
Date: Mon, 27 Jul 2026 21:04:26 +0900
Subject: [PATCH 06/16] x86/pc9800: uPD8251 serial driver + console (ttyS0)

serial_core driver for the PC-9800 internal uPD8251 USART (data 0x30,
mode/cmd/status 0x32, baud via 8253 counter 2 at 0x75/0x77). Registers as
ttyS0 and as a console so console=ttyS0 gives an interactive tty.

Built around two NP2kai realities found by reading its source: TxRDY never
recovers after the first byte (an emulator write-success polarity bug), so TX
writes blind and never gates on TxRDY; and RX only flows once 8253 ch2 is
programmed (it arms the emulator's receive pump), which set_termios does. RX
is polled on a 5ms timer rather than wired through the PC-98 sysport(0x35)/PIC
interrupt gates, for simplicity and robustness during bring-up. With this,
6.12 boots to an interactive userspace shell over the serial console.
---
 drivers/tty/serial/Kconfig     |  17 ++
 drivers/tty/serial/Makefile    |   1 +
 drivers/tty/serial/pc98_8251.c | 327 +++++++++++++++++++++++++++++++++
 3 files changed, 345 insertions(+)
 create mode 100644 drivers/tty/serial/pc98_8251.c

diff --git a/drivers/tty/serial/Kconfig b/drivers/tty/serial/Kconfig
index 28e4beeabf8f..f48b0f08019a 100644
--- a/drivers/tty/serial/Kconfig
+++ b/drivers/tty/serial/Kconfig
@@ -1600,6 +1600,23 @@ config SERIAL_ESP32_ACM
 	  snippet may be used:
 	    earlycon=esp32s3acm,mmio32,0x60038000
 
+config SERIAL_PC98_8251
+	tristate "NEC PC-9800 uPD8251 serial support"
+	depends on X86_PC9800
+	select SERIAL_CORE
+	help
+	  Driver for the NEC PC-9800 internal uPD8251 USART (I/O 0x30/0x32,
+	  baud via 8253 counter 2). Presents as ttyS0. Say Y to use the
+	  built-in serial port as a console under NP2kai.
+
+config SERIAL_PC98_8251_CONSOLE
+	bool "NEC PC-9800 uPD8251 console support"
+	depends on SERIAL_PC98_8251=y
+	select SERIAL_CORE_CONSOLE
+	help
+	  Support for using the PC-9800 uPD8251 serial port as the system
+	  console (console=ttyS0).
+
 endmenu
 
 config SERIAL_MCTRL_GPIO
diff --git a/drivers/tty/serial/Makefile b/drivers/tty/serial/Makefile
index 6ff74f0a9530..27a1a684fae6 100644
--- a/drivers/tty/serial/Makefile
+++ b/drivers/tty/serial/Makefile
@@ -99,3 +99,4 @@ obj-$(CONFIG_SERIAL_MCTRL_GPIO)	+= serial_mctrl_gpio.o
 obj-$(CONFIG_SERIAL_KGDB_NMI) += kgdb_nmi.o
 obj-$(CONFIG_KGDB_SERIAL_CONSOLE) += kgdboc.o
 obj-$(CONFIG_SERIAL_NUVOTON_MA35D1) += ma35d1_serial.o
